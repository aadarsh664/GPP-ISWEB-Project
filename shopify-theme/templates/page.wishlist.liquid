<style>
  .wishlist-page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 4rem var(--page-margin);
    min-height: 50vh;
  }
  .wishlist-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .wishlist-title {
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media screen and (min-width: 768px) {
    .wishlist-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .wishlist-empty {
    text-align: center;
    color: var(--color-gray-800);
    padding: 4rem 0;
    font-size: 1.2rem;
    grid-column: 1 / -1;
  }
  .wishlist-product-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-white);
  }
  .wishlist-product-image {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 4px;
  }
  .wishlist-product-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .wishlist-product-price {
    font-size: 1rem;
    color: var(--color-gray-800);
  }
  .remove-wishlist-btn {
    background: var(--color-foreground);
    color: var(--color-white);
    border: none;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
    margin-top: auto;
  }
</style>

<div class="wishlist-page animate-up">
  <div class="wishlist-header">
    <h1 class="wishlist-title">My Saved Products</h1>
    <p>Items you've liked, all in one place.</p>
  </div>
  
  <div class="wishlist-grid" id="wishlist-grid">
    <div class="wishlist-empty">Loading your saved items...</div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const grid = document.getElementById('wishlist-grid');
    const savedHandles = JSON.parse(localStorage.getItem('gpp_wishlist') || '[]');
    
    if (savedHandles.length === 0) {
      grid.innerHTML = '<div class="wishlist-empty">Your wishlist is empty. Browse products to save them!</div>';
      return;
    }
    
    grid.innerHTML = '';
    
    for (const handle of savedHandles) {
      try {
        const response = await fetch(`/products/${handle}.js`);
        if (!response.ok) continue;
        const product = await response.json();
        
        const price = (product.price / 100).toLocaleString('en-IN', { style: 'currency', currency: 'INR' });
        const image = product.images.length > 0 ? product.images[0] : '';
        
        grid.innerHTML += `
          <div class="wishlist-product-card" data-handle="${handle}">
            <a href="${product.url}">
              <img src="${image}" class="wishlist-product-image" alt="${product.title}">
            </a>
            <a href="${product.url}" class="wishlist-product-title">${product.title}</a>
            <div class="wishlist-product-price">${price}</div>
            <button class="remove-wishlist-btn" onclick="removeFromWishlist('${handle}')">Remove</button>
          </div>
        `;
      } catch (err) {
        console.error('Error loading product:', err);
      }
    }
  });

  window.removeFromWishlist = function(handle) {
    let saved = JSON.parse(localStorage.getItem('gpp_wishlist') || '[]');
    saved = saved.filter(h => h !== handle);
    localStorage.setItem('gpp_wishlist', JSON.stringify(saved));
    
    const card = document.querySelector(`.wishlist-product-card[data-handle="${handle}"]`);
    if (card) card.remove();
    
    if (saved.length === 0) {
      document.getElementById('wishlist-grid').innerHTML = '<div class="wishlist-empty">Your wishlist is empty. Browse products to save them!</div>';
    }
  };
</script>
