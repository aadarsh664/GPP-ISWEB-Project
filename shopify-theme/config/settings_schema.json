[
  {
    "name": "theme_info",
    "theme_name": "GPP Custom",
    "theme_version": "1.0.0",
    "theme_author": "GPP",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Primary Font"
      },
      {
        "type": "range",
        "id": "heading_font_size",
        "min": 16,
        "max": 48,
        "step": 1,
        "unit": "px",
        "label": "Heading font size",
        "default": 28
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Body font size",
        "default": 16
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Core Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "Text / Foreground"
      },
      {
        "type": "header",
        "content": "Brand Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#0056b3",
        "label": "Primary (Brand Blue)"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#0088cc",
        "label": "Accent (Hover Blue)"
      },
      {
        "type": "color",
        "id": "color_success",
        "default": "#0056b3",
        "label": "Success State"
      },
      {
        "type": "color",
        "id": "color_error",
        "default": "#d32f2f",
        "label": "Error State"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "90rem", "label": "Narrow (90rem)" },
          { "value": "110rem", "label": "Wide (110rem)" },
          { "value": "100%", "label": "Full width" }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Spacing & Sizing",
    "settings": [
      {
        "type": "header",
        "content": "Section Spacing"
      },
      {
        "type": "range",
        "id": "section_padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Section padding top",
        "default": 40
      },
      {
        "type": "range",
        "id": "section_padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Section padding bottom",
        "default": 40
      },
      {
        "type": "header",
        "content": "Borders & Radius"
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Card corner radius",
        "default": 8
      }
    ]
  }
]
