<style>
  .product-row-wrapper {
    padding: 3rem 0;
  }

  .product-row-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }

  .product-row-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .product-row-view-all {
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .product-row-view-all::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }

  .product-row-grid-container {
    /* container managed by .page-container */
  }

  .product-row-grid {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem; /* Space for hover effects/shadows */
  }

  .product-row-grid::-webkit-scrollbar {
    display: none;
  }

  .product-row-grid .product-card {
    min-width: 200px;
    width: 200px; /* Fixed width for horizontal scrolling */
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  @media screen and (min-width: 768px) {
    .product-row-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      overflow-x: visible;
      padding-bottom: 0;
    }
    .product-row-grid .product-card {
      width: auto;
      min-width: 0;
    }
  }
</style>

<div class="product-row-wrapper full-width">
  <div class="product-row-header animate-up page-container">
    <h2 class="product-row-title">{{ section.settings.title }}</h2>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="product-row-view-all">View all</a>
    {%- endif -%}
  </div>

  <div class="product-row-grid-container page-container">
    <div class="product-row-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: 5 -%}
          {% render 'product-card', product: product, delay: forloop.index | times: 50 %}
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholder for empty state in editor -->
        {%- for i in (1..5) -%}
          {% render 'product-card', delay: forloop.index | times: 50 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Row",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Luxury Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Row"
    }
  ]
}
{% endschema %}
