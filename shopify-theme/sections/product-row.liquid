<style>
  .product-row-wrapper {
    padding: 3rem 0;
  }

  .product-row-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    padding: 0 var(--page-margin);
    max-width: var(--page-width);
    margin-left: auto;
    margin-right: auto;
  }

  .product-row-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .product-row-view-all {
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .product-row-view-all::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }

  .product-row-grid-container {
    padding: 0 var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .product-row-grid {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem; /* Space for hover effects/shadows */
  }

  .product-row-grid::-webkit-scrollbar {
    display: none;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 200px;
    width: 200px; /* Fixed width for horizontal scrolling */
    text-decoration: none;
    color: var(--color-foreground);
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  @media screen and (min-width: 768px) {
    .product-row-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      overflow-x: visible;
      padding-bottom: 0;
    }
    .product-card {
      width: auto;
      min-width: 0;
    }
  }

  .product-card__image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--color-white);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 1rem;
    position: relative;
    border: 1px solid var(--color-foreground);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__title {
    font-size: 14px;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<div class="product-row-wrapper full-width">
  <div class="product-row-header animate-up">
    <h2 class="product-row-title">{{ section.settings.title }}</h2>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="product-row-view-all">View all</a>
    {%- endif -%}
  </div>

  <div class="product-row-grid-container">
    <div class="product-row-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: 5 -%}
          <a href="{{ product.url }}" class="product-card animate-up" style="transition-delay: {{ forloop.index | times: 50 }}ms;">
            <div class="product-card__image-wrap">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 400 | image_tag: class: 'product-card__image', loading: 'lazy' }}
              {%- else -%}
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-gray-300);">No Image</div>
              {%- endif -%}
            </div>
            <h3 class="product-card__title">{{ product.title }}</h3>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholder for empty state in editor -->
        {%- for i in (1..5) -%}
          <a href="/collections/all" class="product-card">
            <div class="product-card__image-wrap">
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-gray-300);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              </div>
            </div>
            <h3 class="product-card__title">Example Product Title {{ i }}</h3>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Row",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Luxury Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Row"
    }
  ]
}
{% endschema %}
