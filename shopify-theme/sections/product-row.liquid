<style>
  .product-row-wrapper {
    padding: 3rem 0;
  }

  .product-row-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }

  .product-row-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .product-row-view-all {
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .product-row-view-all::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }

  .product-row-grid-container {
    /* container managed by .page-container */
  }

  .product-row-grid {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem; /* Space for hover effects/shadows */
  }

  .product-row-grid::-webkit-scrollbar {
    display: none;
  }

  .product-row-grid .product-card {
    min-width: 200px;
    width: 200px; /* Fixed width for horizontal scrolling */
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  @media screen and (min-width: 768px) {
    .product-row-grid .product-card {
      min-width: 250px;
      width: 250px;
    }
    .product-row-grid::-webkit-scrollbar {
      display: none;
    }
  }

  /* Slider Navigation */
  .row-slider-nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .row-slider-arrow {
    background: var(--color-gray-100);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-foreground);
    transition: all 0.2s;
  }
  .row-slider-arrow:hover {
    background: var(--color-foreground);
    color: var(--color-white);
  }
  @media screen and (max-width: 767px) {
    .row-slider-nav {
      display: none; /* Hide arrows on mobile, rely on touch swipe */
    }
  }
</style>

<div class="product-row-wrapper full-width">
  <div class="product-row-header animate-up page-container">
    <h2 class="product-row-title">{{ section.settings.title }}</h2>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="product-row-view-all">View all</a>
    {%- endif -%}
  </div>

  <div class="product-row-grid-container page-container">
    <div class="product-row-grid" id="product-row-grid-{{ section.id }}">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: 10 -%}
          {% render 'product-card', product: product, delay: forloop.index | times: 50 %}
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholder for empty state in editor -->
        {%- for i in (1..8) -%}
          {% render 'product-card', delay: forloop.index | times: 50 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    <div class="row-slider-nav">
      <button class="row-slider-arrow" id="row-prev-{{ section.id }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
      <button class="row-slider-arrow" id="row-next-{{ section.id }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('product-row-grid-{{ section.id }}');
    const prev = document.getElementById('row-prev-{{ section.id }}');
    const next = document.getElementById('row-next-{{ section.id }}');
    
    if (grid && prev && next) {
      prev.addEventListener('click', () => {
        const itemWidth = grid.querySelector('.product-card').clientWidth + 24; // 24px is gap
        grid.scrollBy({ left: -itemWidth * 2, behavior: 'smooth' });
      });
      next.addEventListener('click', () => {
        const itemWidth = grid.querySelector('.product-card').clientWidth + 24;
        grid.scrollBy({ left: itemWidth * 2, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product Row",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Luxury Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Row"
    }
  ]
}
{% endschema %}
