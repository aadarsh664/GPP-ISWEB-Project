{% comment %}
  Collection page — responsive grid with 2-col mobile layout
{% endcomment %}

<style>
  .collection-page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-padding-top, 40px) var(--page-margin) var(--section-padding-bottom, 40px);
  }

  .collection-page__title {
    font-size: var(--font-heading-size, 28px);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .collection-products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .collection-products .product-card {
    width: 100%;
    min-width: 0;
  }

  .collection-products .product-card__image-wrap {
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 768px) {
    .collection-products {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (min-width: 1200px) {
    .collection-products {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
</style>

<div class="collection-page">
  <h1 class="collection-page__title">{{ collection.title }}</h1>

  <div class="collection-products">
    {% paginate collection.products by 20 %}
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% endfor %}

      {% if paginate.pages > 1 %}
        <div style="grid-column: 1 / -1; text-align: center; margin-top: 2rem;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
