<style>
  .fw-banner-wrapper {
    padding: 0;
    max-width: 100%;
    margin: 0;
  }

  .fw-promo-card {
    position: relative;
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
    text-decoration: none;
    color: var(--color-white);
  }

  @media screen and (min-width: 768px) {
    .fw-promo-card {
      aspect-ratio: 21 / 9;
      padding: 4rem;
    }
  }

  .fw-promo-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.5s ease;
  }

  .fw-promo-card:hover .fw-promo-card__image {
    transform: scale(1.05);
  }

  .fw-promo-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);
    z-index: 2;
  }

  .fw-promo-card__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 500px;
  }

  .fw-promo-card__title {
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .fw-promo-card__title {
      font-size: 3rem;
    }
  }

  .fw-promo-card__price {
    font-size: 1.125rem;
    font-weight: 400;
    opacity: 0.9;
    margin: 0;
  }

  .fw-promo-card__btn {
    margin-top: 1rem;
    background-color: var(--color-white);
    color: var(--color-black);
    border: none;
    font-weight: 400;
  }
</style>

<div class="fw-banner-wrapper full-width">
  <a href="{{ section.settings.link | default: '#' }}" class="fw-promo-card animate-up">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'fw-promo-card__image', loading: 'lazy' }}
    {%- else -%}
      <div class="fw-promo-card__image" style="background-color: var(--color-gray-300);"></div>
    {%- endif -%}
    
    <div class="fw-promo-card__overlay"></div>
    
    <div class="fw-promo-card__content">
      <h3 class="fw-promo-card__title">{{ section.settings.title }}</h3>
      {%- if section.settings.price_text != blank -%}
        <p class="fw-promo-card__price">{{ section.settings.price_text }}</p>
      {%- endif -%}
      <span class="btn fw-promo-card__btn btn-radial-reveal" style="--hover-bg:#000; --hover-color:#fff;">
        <span class="btn-radial-reveal__text">{{ section.settings.button_label | default: 'Shop' }}</span>
      </span>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "Full Width Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bulk ID Cards"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price Text",
      "default": "Starting at just ₹25/-"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Full Width Banner"
    }
  ]
}
{% endschema %}
