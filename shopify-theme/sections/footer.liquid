<script>
  document.addEventListener("DOMContentLoaded", () => {
    const selector = document.getElementById('countrySelector');
    const btn = document.getElementById('countrySelectorBtn');
    const search = document.getElementById('countrySearch');
    const options = document.querySelectorAll('.country-option');
    const selectedFlag = document.getElementById('selectedCountryFlag');

    // Radial Reveal Button Effect global logic
    document.body.addEventListener("mousemove", (e) => {
      const target = e.target.closest(".btn-radial-reveal");
      if (!target) return;
      const rect = target.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      target.style.setProperty("--x", `${x}px`);
      target.style.setProperty("--y", `${y}px`);
    });

    // Toggle dropdown
    btn.addEventListener('click', () => {
      selector.classList.toggle('active');
      if (selector.classList.contains('active')) {
        search.focus();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!selector.contains(e.target)) {
        selector.classList.remove('active');
      }
    });

    // Search logic
    search.addEventListener('input', (e) => {
      const val = e.target.value.toLowerCase();
      options.forEach(opt => {
        const text = opt.innerText.toLowerCase();
        opt.style.display = text.includes(val) ? 'flex' : 'none';
      });
    });

    // Selection logic
    options.forEach(opt => {
      opt.addEventListener('click', () => {
        const flag = opt.getAttribute('data-flag');
        selectedFlag.src = flag;
        selector.classList.remove('active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "With 16 years of industry experience, Guru Printing Press delivers premium commercial bulk printing and custom corporate designs. As Your Reliable Printing Partner, we bring your brand to life."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (with country code)",
      "default": "+919341749399"
    }
  ]
}
{% endschema %}

