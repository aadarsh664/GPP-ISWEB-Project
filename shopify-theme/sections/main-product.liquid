<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // ----------------------------------------------------
    // REAL VARIANTS (Price Affecting) LOGIC
    // ----------------------------------------------------
    const productJsonEl = document.getElementById(`ProductJson-{{ section.id }}`);
    if (productJsonEl) {
      try {
        const productVariants = JSON.parse(productJsonEl.textContent);
        const realVariantGroups = document.querySelectorAll('.real-variant-group');
        const hiddenVariantInput = document.querySelector('input[name="id"]');
        const priceDisplay = document.querySelector('.product-price');

        const updateVariant = () => {
          let selectedOptions = {};
          realVariantGroups.forEach(g => {
            const pos = g.getAttribute('data-option-position');
            const activePill = g.querySelector('.real-variant-pill.active');
            const activeSelect = g.querySelector('.real-variant-select');
            
            if (activePill) {
              selectedOptions[pos] = activePill.getAttribute('data-value');
            } else if (activeSelect) {
              selectedOptions[pos] = activeSelect.value;
            }
          });

          // Find matching variant
          const matchedVariant = productVariants.find(variant => {
            return (
              (!selectedOptions['option1'] || variant.option1 === selectedOptions['option1']) &&
              (!selectedOptions['option2'] || variant.option2 === selectedOptions['option2']) &&
              (!selectedOptions['option3'] || variant.option3 === selectedOptions['option3'])
            );
          });

          if (matchedVariant) {
            // Update Hidden Input for cart
            if (hiddenVariantInput) {
              hiddenVariantInput.value = matchedVariant.id;
            }
            
            // Update Price Display
            if (priceDisplay) {
              const formatter = new Intl.NumberFormat('en-IN');
              priceDisplay.innerHTML = '₹' + formatter.format(matchedVariant.price / 100);
            }

            // Update Unit Text if Quantity variant changed
            const unitText = document.querySelector('.product-unit-text');
            if (unitText) {
              // Try to find if one of the selected options is for Quantity
              realVariantGroups.forEach(g => {
                const optName = g.getAttribute('data-option-name');
                if (optName && (optName.toLowerCase().includes('quantity') || optName.toLowerCase().includes('qty'))) {
                  const pos = g.getAttribute('data-option-position');
                  if (selectedOptions[pos]) {
                    unitText.textContent = `for ${selectedOptions[pos]} units`;
                  }
                }
              });
            }
            
            // Update URL
            const url = new URL(window.location);
            url.searchParams.set('variant', matchedVariant.id);
            window.history.replaceState({}, '', url);
          }
        };

        realVariantGroups.forEach(group => {
          const pills = group.querySelectorAll('.real-variant-pill');
          pills.forEach(pill => {
            pill.addEventListener('click', () => {
              pills.forEach(p => p.classList.remove('active'));
              pill.classList.add('active');
              updateVariant();
            });
          });

          const selectEl = group.querySelector('.real-variant-select');
          if (selectEl) {
            selectEl.addEventListener('change', () => {
              updateVariant();
            });
          }
        });
        
        // Initial run
        updateVariant();
      } catch (e) {
        console.warn('Error parsing product variants JSON', e);
      }
    }

    // ----------------------------------------------------
    // COSMETIC OPTIONS (Progressive Disclosure) LOGIC
    // ----------------------------------------------------
    const allVariantGroups = document.querySelectorAll('.cosmetic-group');
    
    allVariantGroups.forEach((group) => {
      const items = group.querySelectorAll('.variant-pill, .color-swatch');
      const propTargetId = group.getAttribute('data-prop-target');
      const hiddenInput = document.getElementById(propTargetId);
      const groupIndex = parseInt(group.getAttribute('data-group-index'), 10);
      
      items.forEach(item => {
        item.addEventListener('click', () => {
          // Remove active from all siblings
          items.forEach(i => i.classList.remove('active'));
          item.classList.add('active');
          
          if(item.classList.contains('color-swatch')) {
            items.forEach(i => i.style.border = '2px solid transparent');
            item.style.border = '2px solid var(--color-foreground)';
          }

          // Set hidden input value for Line Item Properties
          if (hiddenInput) {
            hiddenInput.value = item.getAttribute('data-value');
          }

          // Reveal next group
          const nextGroup = document.querySelector(`.variant-group[data-group-index="${groupIndex + 1}"]`);
          if (nextGroup) {
            nextGroup.classList.add('is-visible');
          }
        });
      });
    });

    // Upload Logic
    const btnDragBrowse = document.getElementById('btn-drag-browse');
    const btnDesignService = document.getElementById('btn-design-service');
    const uploadInstructions = document.getElementById('upload-instructions');
    
    if (btnDragBrowse && btnDesignService && uploadInstructions) {
      const fileInput = document.getElementById('design-file-input');
      const fileUrlInput = document.getElementById('design-file-url');
      const progressContainer = document.getElementById('upload-progress-container');
      const progressBar = document.getElementById('upload-progress-bar');
      const progressText = document.getElementById('upload-progress-text');

      btnDragBrowse.addEventListener('click', () => {
        btnDragBrowse.classList.add('active');
        btnDesignService.classList.remove('active');
        uploadInstructions.classList.add('active');
        // Trigger file picker
        if (fileInput) fileInput.click();
      });
      
      btnDesignService.addEventListener('click', () => {
        btnDesignService.classList.add('active');
        btnDragBrowse.classList.remove('active');
        uploadInstructions.classList.remove('active');
        // Clear file url if they switch to design service
        if (fileUrlInput) fileUrlInput.value = 'Designing Service Requested';
      });

      // Handle file selection and AJAX upload
      if (fileInput) {
        fileInput.addEventListener('change', function() {
          if (this.files && this.files[0]) {
            const file = this.files[0];
            
            // Show progress UI
            progressContainer.style.display = 'block';
            btnDragBrowse.textContent = 'Uploading...';
            
            // File Identification: prepend timestamp and cart token
            const timestamp = Date.now();
            const cartToken = document.cookie.match(/(^|;)\s*cart=([^;]+)/)?.pop() || 'guest';
            const newFilename = `${timestamp}_${cartToken}_${file.name}`;
            
            const formData = new FormData();
            formData.append('designFile', file, newFilename);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', 'https://gpp-isweb-project.onrender.com/api/upload', true);
            xhr.timeout = 90000; // 90 seconds timeout for Render cold start

            // Cold start UX: If it takes more than 3 seconds to start uploading
            const coldStartTimeout = setTimeout(() => {
              btnDragBrowse.textContent = 'Waking up secure server, please wait...';
            }, 3000);

            xhr.upload.onprogress = function(e) {
              if (e.lengthComputable) {
                const percentComplete = Math.round((e.loaded / e.total) * 100);
                
                // Once it actually starts pushing bytes, clear the cold start message
                if (percentComplete > 0) {
                  clearTimeout(coldStartTimeout);
                  btnDragBrowse.textContent = 'Uploading...';
                }
                
                progressBar.style.width = percentComplete + '%';
                progressText.textContent = percentComplete + '%';
              }
            };

            xhr.onload = function() {
              clearTimeout(coldStartTimeout);
              if (xhr.status === 200) {
                const response = JSON.parse(xhr.responseText);
                if (response.success && fileUrlInput) {
                  fileUrlInput.value = response.fileUrl;
                  btnDragBrowse.textContent = 'File Uploaded Successfully ✓';
                  btnDragBrowse.style.backgroundColor = '#0056b3'; // Brand Blue
                  btnDragBrowse.style.color = '#fff';
                  progressText.textContent = 'Complete';
                }
              } else {
                alert('Upload failed. Please try again.');
                btnDragBrowse.textContent = 'Drop or click to browse';
                progressContainer.style.display = 'none';
              }
            };

            xhr.onerror = function() {
              clearTimeout(coldStartTimeout);
              alert('Error connecting to upload server. Is the backend running?');
              btnDragBrowse.textContent = 'Drop or click to browse';
              progressContainer.style.display = 'none';
            };

            xhr.ontimeout = function() {
              clearTimeout(coldStartTimeout);
              alert('Upload timed out. The server took too long to wake up. Please try again.');
              btnDragBrowse.textContent = 'Drop or click to browse';
              progressContainer.style.display = 'none';
            };

            xhr.send(formData);
          }
        });
      }
    }

    // Shiprocket Pincode Checker Logic
    const pincodeBtn = document.getElementById('pincode-check-btn');
    const pincodeInput = document.getElementById('pincode-input');
    const pincodeMessage = document.getElementById('pincode-message');

    if (pincodeBtn && pincodeInput && pincodeMessage) {
      pincodeBtn.addEventListener('click', async () => {
        const pincode = pincodeInput.value.trim();
        if (pincode.length !== 6 || isNaN(pincode)) {
          alert('Please enter a valid 6-digit pincode');
          return;
        }

        pincodeBtn.textContent = 'Checking...';
        
        try {
          // --- SHIPROCKET API INTEGRATION (PROXY SCAFFOLDING) ---
          // Note: Exposing Shiprocket tokens on the frontend is a security risk.
          // This fetch is structured to hit a proxy backend (e.g. your Render backend or Shopify App)
          // The backend should securely hold the Shiprocket Token and make the actual API call.
          
          /*
          const response = await fetch(`https://gpp-isweb-project.onrender.com/api/pincode?code=${pincode}`);
          if (!response.ok) throw new Error('API Request Failed');
          const data = await response.json();
          */

          // Mocking Backend Response Logic for standard vs remote areas
          await new Promise(resolve => setTimeout(resolve, 800)); // simulate network delay
          let etd = '4-5 business days';
          let costText = 'FREE DELIVERY';
          
          // Specific remote area logic (e.g., Andaman and Nicobar Islands)
          if (pincode.startsWith('744')) {
            etd = '8-10 business days';
            costText = 'Delivery Charge: ₹150 (Remote Area)';
          }

          pincodeMessage.innerHTML = `
            Congratulation you are eligible for <strong>${costText}</strong>.<br>
            <div style="display:flex; align-items:center; gap:6px; margin-top:4px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              <span id="pincode-date">Estimated Delivery By: ${etd}</span>
            </div>
          `;
        } catch (error) {
          console.warn('Pincode check failed:', error);
          pincodeMessage.innerHTML = `<span style="color:#d32f2f;">Unable to verify pincode at this time. Please try again.</span>`;
        }
        
        pincodeBtn.textContent = 'Check';
      });
    }
    // Product Slider Logic
    const slider = document.getElementById('product-slider');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    const dots = document.querySelectorAll('.slider-dot');

    if (slider && prevBtn && nextBtn) {
      const scrollAmount = slider.clientWidth;

      prevBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });

      // Update dots on scroll
      slider.addEventListener('scroll', () => {
        const index = Math.round(slider.scrollLeft / slider.clientWidth);
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      });

      // Click dots to scroll
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          slider.scrollTo({ left: i * slider.clientWidth, behavior: 'smooth' });
        });
      });
    }

    // Wishlist Toggle Logic
    const wishlistBtns = document.querySelectorAll('.wishlist-btn');
    if (wishlistBtns.length > 0) {
      let saved = JSON.parse(localStorage.getItem('gpp_wishlist') || '[]');
      const handle = wishlistBtns[0].getAttribute('data-product-handle');
      
      if (saved.includes(handle)) {
        wishlistBtns.forEach(btn => btn.classList.add('active'));
      }

      wishlistBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const handle = btn.getAttribute('data-product-handle');
          let currentSaved = JSON.parse(localStorage.getItem('gpp_wishlist') || '[]');
          
          if (currentSaved.includes(handle)) {
            currentSaved = currentSaved.filter(h => h !== handle);
            wishlistBtns.forEach(b => b.classList.remove('active'));
          } else {
            currentSaved.push(handle);
            wishlistBtns.forEach(b => b.classList.add('active'));
          }
          
          localStorage.setItem('gpp_wishlist', JSON.stringify(currentSaved));
        });
      });
    }
  });
</script>
