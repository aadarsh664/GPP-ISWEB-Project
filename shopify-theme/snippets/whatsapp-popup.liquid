{% if customer %}
<style>
  .whatsapp-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .whatsapp-modal-overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .whatsapp-modal {
    background: #ffffff;
    width: 90%;
    max-width: 400px;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    transform: translateY(20px) scale(0.95);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-align: center;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .whatsapp-modal-overlay.is-visible .whatsapp-modal {
    transform: translateY(0) scale(1);
  }

  .whatsapp-modal-icon {
    width: 48px;
    height: 48px;
    background: #000;
    color: #fff;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .whatsapp-modal-title {
    font-size: 20px;
    font-weight: 600;
    color: #000;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .whatsapp-modal-desc {
    font-size: 14px;
    color: #666;
    line-height: 1.5;
    margin: 0 0 2rem 0;
  }

  .whatsapp-modal-input-group {
    position: relative;
    margin-bottom: 1.5rem;
    display: flex;
  }

  .whatsapp-modal-prefix {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #000;
    font-weight: 500;
    font-size: 15px;
    pointer-events: none;
  }

  .whatsapp-modal-input {
    width: 100%;
    background: #f8f8f8;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    padding: 14px 16px 14px 48px;
    font-size: 15px;
    color: #000;
    transition: all 0.2s ease;
    outline: none;
    font-family: inherit;
  }

  .whatsapp-modal-input:focus {
    background: #fff;
    border-color: #000;
    box-shadow: 0 0 0 1px #000;
  }

  .whatsapp-modal-submit {
    width: 100%;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 14px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
  }

  .whatsapp-modal-submit:hover {
    background: #222;
  }

  .whatsapp-modal-submit:active {
    transform: scale(0.98);
  }

  .whatsapp-modal-close {
    background: none;
    border: none;
    color: #999;
    font-size: 13px;
    margin-top: 1rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .whatsapp-modal-close:hover {
    color: #000;
  }
</style>

<div class="whatsapp-modal-overlay" id="whatsapp-popup">
  <div class="whatsapp-modal">
    <div class="whatsapp-modal-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
    </div>
    <h3 class="whatsapp-modal-title">Order Updates on WhatsApp</h3>
    <p class="whatsapp-modal-desc">Stay informed about your design drafts, printing status, and delivery tracking.</p>
    
    <div class="whatsapp-modal-input-group">
      <span class="whatsapp-modal-prefix">+91</span>
      <input type="tel" id="whatsapp-number-input" class="whatsapp-modal-input" placeholder="Enter mobile number" maxlength="10" pattern="[0-9]{10}">
    </div>
    
    <button class="whatsapp-modal-submit" id="whatsapp-submit-btn">Enable Updates</button>
    <button class="whatsapp-modal-close" id="whatsapp-close-btn">Maybe later</button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('whatsapp-popup');
    const submitBtn = document.getElementById('whatsapp-submit-btn');
    const closeBtn = document.getElementById('whatsapp-close-btn');
    const input = document.getElementById('whatsapp-number-input');

    // Check if we already captured it
    if (!localStorage.getItem('gpp_whatsapp_captured')) {
      // Small delay for smooth entry
      setTimeout(() => {
        popup.classList.add('is-visible');
      }, 1500);
    }

    const closePopup = () => {
      popup.classList.remove('is-visible');
      // Set flag so we don't bother them again if they dismissed it
      localStorage.setItem('gpp_whatsapp_captured', 'dismissed');
    };

    closeBtn.addEventListener('click', closePopup);

    submitBtn.addEventListener('click', async () => {
      const number = input.value.trim();
      if (number.length !== 10 || isNaN(number)) {
        input.style.borderColor = 'red';
        return;
      }

      submitBtn.textContent = 'Saving...';
      submitBtn.style.opacity = '0.7';

      const fullNumber = '+91 ' + number;

      try {
        // Save to Cart Attributes for native order tracking
        await fetch(window.Shopify.routes.root + 'cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            attributes: {
              'WhatsApp Number': fullNumber
            }
          })
        });

        // Mark as completed locally
        localStorage.setItem('gpp_whatsapp_captured', 'true');
        
        submitBtn.textContent = 'Saved!';
        submitBtn.style.background = '#4CAF50';
        
        setTimeout(() => {
          popup.classList.remove('is-visible');
        }, 1000);

      } catch (error) {
        console.error('Error saving WhatsApp number:', error);
        submitBtn.textContent = 'Enable Updates';
        submitBtn.style.opacity = '1';
        alert('Something went wrong. Please try again.');
      }
    });
  });
</script>
{% endif %}
