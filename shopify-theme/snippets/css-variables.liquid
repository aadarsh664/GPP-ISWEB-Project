{% style %}
  /* Custom Font Setup: Helvetica Now Display */
  @font-face {
    font-family: 'Helvetica Now Display';
    src: local('Helvetica Now Display'), local('HelveticaNowDisplay-Regular'),
         url('{{ "HelveticaNowDisplay-Regular.woff2" | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Helvetica Now Display';
    src: local('Helvetica Now Display Medium'), local('HelveticaNowDisplay-Medium'),
         url('{{ "HelveticaNowDisplay-Medium.woff2" | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Helvetica Now Display';
    src: local('Helvetica Now Display Bold'), local('HelveticaNowDisplay-Bold'),
         url('{{ "HelveticaNowDisplay-Bold.woff2" | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Core Colors (from Theme Editor) */
    --color-black: #000000;
    --color-white: #ffffff;
    --color-gray-100: #f4f4f5;
    --color-gray-200: #e4e4e7;
    --color-gray-300: #d4d4d8;
    --color-gray-800: #27272a;
    
    --color-background: {{ settings.background_color | default: '#FFFFFF' }};
    --color-foreground: {{ settings.foreground_color | default: '#333333' }};
    --color-border: var(--color-gray-200);

    /* Brand Colors (from Theme Editor) */
    --color-primary: {{ settings.color_primary | default: '#0056b3' }};
    --color-accent: {{ settings.color_accent | default: '#0088cc' }};
    --color-success: {{ settings.color_success | default: '#0056b3' }};
    --color-error: {{ settings.color_error | default: '#d32f2f' }};

    /* Typography (from Theme Editor) */
    --font-primary-family: 'Helvetica Now Display', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-primary-weight: 400;
    --font-heading-weight: 500;
    --font-heading-size: {{ settings.heading_font_size | default: 28 }}px;
    --font-body-size: {{ settings.body_font_size | default: 16 }}px;
    
    /* Layout (from Theme Editor) */
    --page-width: {{ settings.max_page_width | default: '110rem' }};
    --page-margin: {{ settings.min_page_margin | default: 20 }}px;
    
    /* Spacing (from Theme Editor) */
    --section-padding-top: {{ settings.section_padding_top | default: 40 }}px;
    --section-padding-bottom: {{ settings.section_padding_bottom | default: 40 }}px;

    /* Border Radius (from Theme Editor) */
    --radius-sm: {{ settings.card_border_radius | default: 8 }}px;
    --radius-md: {{ settings.button_border_radius | default: 8 }}px;
    --radius-lg: 16px;
    --radius-full: 9999px;
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 4 }}px;
  }
{% endstyle %}
