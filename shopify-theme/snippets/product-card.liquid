{% comment %}
  Renders a product card with hover zoom and image swap.
  Accepts:
  - product: {Object} Product Liquid object
  - delay: {Number} Transition delay in ms for animation (optional)
{% endcomment %}

<a href="{{ product.url | default: '#' }}" class="product-card animate-up" {% if delay %}style="transition-delay: {{ delay }}ms;"{% endif %}>
  <div class="product-card__image-wrap">
    {%- if product != blank and product.featured_image -%}
      {{ product.featured_image | image_url: width: 400 | image_tag: class: 'product-card__image product-card__image--primary', loading: 'lazy' }}
      {%- if product.images[1] -%}
        {{ product.images[1] | image_url: width: 400 | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy' }}
      {%- endif -%}
    {%- else -%}
      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-gray-300);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      </div>
    {%- endif -%}
  </div>
  <h3 class="product-card__title">{{ product.title | default: 'Example Product' }}</h3>
</a>
